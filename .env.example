# --- Required in production ---
# Long random string used to sign short-lived sign-in state. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Public URL of the app, used in email links.
APP_URL=http://localhost:3000

# --- Database ---
# Leave empty to use the built-in embedded PostgreSQL (PGlite), stored in ./data/pglite.
# Set to a PostgreSQL connection string to use a Postgres server, e.g. Neon, Supabase or a local Postgres.
DATABASE_URL=

# --- Email (Nodemailer, any SMTP provider) ---
# Leave SMTP_HOST empty in development: emails, including sign-in codes, are printed in the server console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FlipAdmit <no-reply@example.com>"

# --- Platform admin (created on first start; signs in like any user, with a code sent to ADMIN_EMAIL) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI (Nebius Token Factory). Leave NEBIUS_API_KEY empty to run on built-in fallbacks. ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_MODEL_MAIN=openai/gpt-oss-120b
LLM_MODEL_CHEAP=openai/gpt-oss-120b
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
LLM_DAILY_BUDGET_USD=5
